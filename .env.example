# 이 파일을 복사해 .env 로 만든 뒤 값을 채우세요. (.env는 Git에 올리지 않습니다)

# AI_PROVIDER: mock(개발·테스트용, 기본값) | claude | gemini | openai
# 팀 결정(11/10): 실제 API는 Claude. 팀원은 평소 mock으로 개발합니다.
AI_PROVIDER=mock
# 실제 API를 쓸 때만 채웁니다. 키는 정회성이 관리하며 절대 공유·커밋하지 않습니다.
AI_API_KEY=
# 실제 API 사용 시 예: AI_MODEL=claude-haiku-5-5  (품질이 부족하면 claude-sonnet-5-5)
AI_MODEL=
# 응답 대기 시간(초)
AI_TIMEOUT=30

DATABASE_URL=sqlite:///./app/db/app.db
